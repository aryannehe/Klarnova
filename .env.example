# Klarnova — environment configuration (copy to .env and adjust)
ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://klarnova:klarnova@localhost:5433/klarnova
REDIS_URL=redis://localhost:6379/0

# Shared token for the Alertmanager webhook (KLR-C4)
WEBHOOK_TOKEN=klarnova-dev-token

# Auto-Discovery overrides (KLR-C3); leave blank to auto-detect
PROMETHEUS_URL=
ALERTMANAGER_URL=

# Monitoring agent (KLR-C5)
MONITORING_ENABLED=true
MONITORING_POLL_INTERVAL_SECONDS=30
