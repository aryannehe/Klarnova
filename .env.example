# ===== Klarnova environment configuration (copy to .env and fill secrets) =====

# --- LLM provider: openai | gemini | ollama ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# --- Databases ---
# PostgreSQL (asyncpg) - local dev on existing pgvector container
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/klarnova
REDIS_URL=redis://localhost:6379/0

# ChromaDB (vector store) - in-process persistent mode for dev
CHROMA_PERSIST_DIR=F:\Klarnova\data\chroma
# ChromaDB client-server mode (optional):
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Kubernetes ---
# true when running inside the cluster, false (KUBECONFIG) for dev
KUBE_IN_CLUSTER=false
TARGET_NAMESPACE=default

# --- Observability ---
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_WEBHOOK_TOKEN=dev-token
# LOKI_URL=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRY=3600

# --- Knowledge base ---
KB_REFRESH_INTERVAL=3600
KB_SOURCE_LIST=knowledge-base/sources.yaml

# --- Notifications ---
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
